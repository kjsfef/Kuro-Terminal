<Window x:Class="Kuro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kuro Terminal"
        Icon="Assets/Kuro.ico"
        Width="1120"
        Height="720"
        MinWidth="780"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{StaticResource TerminalTextBrush}"
        FontFamily="Cascadia Mono, Consolas"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        StateChanged="Window_OnStateChanged">

    <Window.Resources>
        <Style x:Key="WindowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9B99AA" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Margin="4,5"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#18FFFFFF" />
                                <Setter Property="Foreground" Value="#F5F7FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Margin="4,5"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#D84B64" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground" Property="Background" Value="#B93B52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#555366" />
        </Style>
    </Window.Resources>

    <Grid Background="Transparent">
        <!-- A separate shadow layer keeps the edge soft instead of making the border look thick. -->
        <Border x:Name="ShadowFrame"
                Margin="20"
                CornerRadius="22"
                Background="#01000000"
                IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48"
                                  ShadowDepth="10"
                                  Opacity="0.48"
                                  Color="#000000" />
            </Border.Effect>
        </Border>

        <!-- Thin theme-aware outer stroke. -->
        <Border x:Name="OuterFrame"
                Margin="18"
                CornerRadius="22"
                BorderThickness="1"
                Background="Transparent"
                SnapsToDevicePixels="True">
            <Border x:Name="WindowFrame"
                    Margin="1"
                    CornerRadius="21"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
                <Grid ClipToBounds="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Very subtle inner edge highlight for a glass-panel feel. -->
                    <Border x:Name="InnerHighlight"
                            Grid.RowSpan="2"
                            Margin="1"
                            CornerRadius="20"
                            BorderThickness="1"
                            Background="Transparent"
                            IsHitTestVisible="False" />

                    <Border x:Name="TopGlow"
                            Grid.RowSpan="2"
                            Height="1"
                            VerticalAlignment="Top"
                            Margin="34,0,34,0"
                            CornerRadius="0.5"
                            IsHitTestVisible="False" />

                    <Border x:Name="TitleBar"
                            Grid.Row="0"
                            CornerRadius="20,20,0,0"
                            BorderThickness="0,0,0,1"
                            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="15,0,0,0">
                                <Border Width="28"
                                        Height="28"
                                        Padding="2"
                                        CornerRadius="9"
                                        Background="#0EFFFFFF">
                                    <Image Stretch="Uniform"
                                           Source="Assets/Kuro.png" />
                                </Border>
                                <TextBlock x:Name="TitleNameText"
                                           Text="kuro"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe UI"
                                           FontSize="13.5"
                                           FontWeight="SemiBold" />
                                <TextBlock x:Name="TitleVersionText"
                                           Text="v1.1.1"
                                           Margin="8,1,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="10.5"
                                           Foreground="#777385" />
                            </StackPanel>

                            <TextBlock x:Name="TitlePathText"
                                       Grid.Column="1"
                                       Text="~/"
                                       Margin="24,0,12,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="12" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0">
                                <Button Style="{StaticResource WindowButtonStyle}"
                                        Content="—"
                                        ToolTip="Minimize"
                                        Click="MinimizeButton_OnClick" />
                                <Button x:Name="MaximizeButton"
                                        Style="{StaticResource WindowButtonStyle}"
                                        Content="□"
                                        ToolTip="Maximize"
                                        Click="MaximizeButton_OnClick" />
                                <Button Style="{StaticResource CloseButtonStyle}"
                                        Content="✕"
                                        ToolTip="Close"
                                        Click="CloseButton_OnClick" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <Image Source="Assets/Kuro.png"
                               Width="360"
                               Height="360"
                               Margin="0,0,38,28"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Opacity="0.022"
                               IsHitTestVisible="False"
                               Stretch="Uniform" />

                        <Border x:Name="AccentRail"
                                Width="1"
                                Margin="0,24,0,24"
                                HorizontalAlignment="Left"
                                CornerRadius="0.5" />

                        <RichTextBox x:Name="TerminalBox"
                                     Margin="2,0,2,2"
                                     Padding="21,18,17,21"
                                     BorderThickness="0"
                                     AcceptsTab="True"
                                     IsUndoEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="False"
                                     PreviewKeyDown="TerminalBox_OnPreviewKeyDown"
                                     PreviewTextInput="TerminalBox_OnPreviewTextInput">
                            <FlowDocument PagePadding="0"
                                          LineHeight="Auto"
                                          FontFamily="Cascadia Mono, Consolas" />
                        </RichTextBox>

                        <Border x:Name="BottomGlow"
                                Height="1"
                                Margin="32,0,32,10"
                                VerticalAlignment="Bottom"
                                CornerRadius="0.5"
                                Opacity="0.45"
                                IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
