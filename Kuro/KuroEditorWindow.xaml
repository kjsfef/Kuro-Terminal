<Window x:Class="Kuro.KuroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kuro Editor"
        Width="980"
        Height="680"
        MinWidth="680"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button">
            <Setter Property="Foreground" Value="#DDE8F2" />
            <Setter Property="Background" Value="#111B26" />
            <Setter Property="BorderBrush" Value="#334B61" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                CornerRadius="7"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#193149" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#558FD1" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#0C1722" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="18"
            BorderThickness="1"
            BorderBrush="#5B4D8FC8"
            Background="#F20A1017"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="17,17,0,0"
                    BorderThickness="0,0,0,1"
                    BorderBrush="#283C4B5A"
                    Background="#F5121B25"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EditorTitle"
                                   Text="Kuro Editor"
                                   Foreground="#F2F7FC"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   FontSize="13.5" />
                        <TextBlock x:Name="EditorPath"
                                   Text="new file"
                                   Foreground="#71869A"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="10.5"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource EditorButton}"
                                Width="36"
                                Padding="0"
                                Content="—"
                                Click="Minimize_Click" />
                        <Button Style="{StaticResource EditorButton}"
                                Width="36"
                                Padding="0"
                                Content="□"
                                Click="Maximize_Click" />
                        <Button Style="{StaticResource EditorButton}"
                                Width="36"
                                Padding="0"
                                Content="×"
                                Click="Close_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="10">
                <Border CornerRadius="10"
                        BorderBrush="#263E5266"
                        BorderThickness="1"
                        Background="#D7070C12">
                    <TextBox x:Name="EditorBox"
                             Padding="14,12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent"
                             Foreground="#DCE7F1"
                             CaretBrush="#65D9FF"
                             SelectionBrush="#465E4D96"
                             BorderThickness="0"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="14"
                             SpellCheck.IsEnabled="False"
                             TextChanged="EditorBox_TextChanged"
                             PreviewKeyDown="EditorBox_PreviewKeyDown" />
                </Border>
            </Grid>

            <Border Grid.Row="2"
                    CornerRadius="0,0,17,17"
                    BorderThickness="0,1,0,0"
                    BorderBrush="#283C4B5A"
                    Background="#F5101821">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StatusText"
                               VerticalAlignment="Center"
                               Foreground="#7891A6"
                               FontFamily="Cascadia Mono, Consolas"
                               FontSize="11" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <CheckBox x:Name="WrapCheckBox"
                                  Content="wrap"
                                  Foreground="#9DB1C4"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0"
                                  Checked="WrapCheckBox_Changed"
                                  Unchecked="WrapCheckBox_Changed" />
                        <Button Style="{StaticResource EditorButton}"
                                Content="VS Code"
                                Click="OpenCode_Click" />
                        <Button Style="{StaticResource EditorButton}"
                                Content="Save As"
                                Click="SaveAs_Click" />
                        <Button Style="{StaticResource EditorButton}"
                                Content="Save"
                                Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
